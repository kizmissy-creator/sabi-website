{
  "$schema": "./service-form-contract.schema.json",
  "contractId": "sabi-writing-clarity-v0",
  "status": "development-disabled",
  "source": {
    "portfolioFrameworkId": "1T_N4Rfi6JMQyiQNQJUmV-zf4N3T3F3qC3KCLzSUjTls",
